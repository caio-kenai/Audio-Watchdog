#include <windows.h>
#include <commctrl.h>
#include "setup_res.h"
#include "version.h"

#pragma code_page(65001)

IDI_APP ICON "logo.ico"
// IDR_PAYLOAD: generated by CMake with the absolute path of the freshly
// built AudioWatchdog.exe (never a stale copy found next to this file).
#include "payload.rc"

IDD_SETUP DIALOGEX 0, 0, 330, 262
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Instalação do Audio Watchdog"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_SETUP_ICON, "Static", SS_ICON | SS_REALSIZEIMAGE, 12, 10, 32, 32
    LTEXT           "Audio Watchdog", IDC_SETUP_TITLE, 52, 10, 266, 14
    LTEXT           "", IDC_SETUP_SUBTITLE, 52, 27, 266, 10
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 0, 46, 330, 1

    GROUPBOX        "Funcionalidades", -1, 10, 54, 310, 112
    AUTOCHECKBOX    "Remover modo exclusivo dos dispositivos de áudio", IDC_SETUP_EXCL, 18, 67, 294, 10
    LTEXT           "Obrigatório — é a funcionalidade principal do Audio Watchdog.", IDC_SETUP_EXCL_NOTE, 30, 79, 282, 10
    AUTOCHECKBOX    "Padronizar taxa de amostragem e profundidade de bits dos dispositivos de áudio", IDC_SETUP_FORMAT, 18, 95, 294, 10
    LTEXT           "Taxa de amostragem:", IDC_SETUP_RATE_LBL, 30, 111, 76, 10
    COMBOBOX        IDC_SETUP_RATE, 108, 109, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Profundidade de bits:", IDC_SETUP_BITS_LBL, 30, 127, 76, 10
    COMBOBOX        IDC_SETUP_BITS, 108, 125, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Aplicado apenas nos dispositivos que suportam o formato escolhido; os demais não são alterados.", IDC_SETUP_FMT_NOTE, 30, 144, 282, 18

    LTEXT           "Pasta de instalação:", -1, 10, 174, 310, 10
    EDITTEXT        IDC_SETUP_DIR, 10, 186, 250, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Procurar...", IDC_SETUP_BROWSE, 266, 186, 54, 14
    AUTOCHECKBOX    "Iniciar o Audio Watchdog ao concluir", IDC_SETUP_LAUNCH, 10, 206, 310, 10

    CONTROL         "", IDC_SETUP_PROGRESS, PROGRESS_CLASS, NOT WS_VISIBLE | WS_BORDER, 10, 222, 310, 8
    LTEXT           "", IDC_SETUP_STATUS, 10, 232, 200, 10
    DEFPUSHBUTTON   "Instalar", IDOK, 212, 242, 52, 14
    PUSHBUTTON      "Cancelar", IDCANCEL, 268, 242, 52, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AWW_VERSION_RC
 PRODUCTVERSION AWW_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "caio-kenai"
            VALUE "FileDescription", "Audio Watchdog Setup"
            VALUE "FileVersion", AWW_VERSION_STR
            VALUE "InternalName", "AudioWatchdog-Setup"
            VALUE "OriginalFilename", "AudioWatchdog-Setup.exe"
            VALUE "ProductName", "Audio Watchdog"
            VALUE "ProductVersion", AWW_VERSION_STR
            VALUE "LegalCopyright", "Copyright (C) 2026 caio-kenai. AGPL-3.0."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
